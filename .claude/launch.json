{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "procerno",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3200"
      ],
      "port": 3200
    },
    {
      "name": "procerno-open-collect-only",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_SUPABASE_URL=",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY=",
        "RUN_COLLECT_ONLY=1",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "3220"
      ],
      "port": 3220
    },
    {
      "name": "procerno-open",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_SUPABASE_URL=",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY=",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "3210"
      ],
      "port": 3210
    },
    {
      "name": "procerno-local-sqlite",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=",
        "NEXT_PUBLIC_SUPABASE_URL=",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY=",
        "RUN_COLLECT_ONLY=1",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "3240"
      ],
      "port": 3240
    }
  ]
}